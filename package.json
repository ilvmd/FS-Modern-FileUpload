{
  "name": "file-upload-control",
  "version": "1.0.0",
  "description": "PCF control that lets users stage file uploads on a Dataverse Create form and persists them as Annotations (Notes) once the record is saved.",
  "scripts": {
    "build": "pcf-scripts build",
    "clean": "pcf-scripts clean",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes",
    "lint": "eslint ./FileUploadControl/**/*.ts*",
    "lint:fix": "eslint ./FileUploadControl/**/*.ts* --fix",
    "push": "pac pcf push --solution-unique-name FSOSPCFControls",
    "push:incremental": "pac pcf push --solution-unique-name FSOSPCFControls --incremental",
    "build:tw": "tailwindcss -i ./FileUploadControl/css/GIT-tailwind.src.css -o ./FileUploadControl/css/FileUploadControl-v1.1.css --minify",
    "watch:tw": "tailwindcss -i ./FileUploadControl/css/GIT-tailwind.src.css -o ./FileUploadControl/css/FileUploadControl-v1.1.css --watch"
  },
  "devDependencies": {
    "@microsoft/eslint-plugin-power-apps": "^0.2.51",
    "@types/node": "^18.19.0",
    "@types/powerapps-component-framework": "^1.3.4",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
